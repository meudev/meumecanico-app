{
  "expo": {
    "name": "meumecanico-app",
    "slug": "meumecanico-app",
    "scheme": "your-app-scheme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#009EFA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digitalmovel.meumecanicoapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#009EFA"
      },
      "package": "com.digitalmovel.meumecanicoapp"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
